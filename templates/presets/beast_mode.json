    "style": "top_banner",
    "fontFamily": "Anton",
    "fontSize": 84,
    "textColor": "#FFE600",
    "outlineColor": "#000000",
    "outlineWidth": 6,
    "boxEnabled": false,
    "durationMs": 2000
