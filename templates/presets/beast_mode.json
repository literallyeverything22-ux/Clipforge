{
  "id": "beast_mode",
  "name": "Beast Mode",
  "order": 5,
  "description": "Aggressive, heavyweight typography for viral hook-driven clips.",
  "category": "dynamic",
  "recommended": false,
  "bestFor": "Motivation, business, fitness, controversial opinions",
  "canvas": {
    "aspectRatio": "9:16",
    "width": 1080,
    "height": 1920
