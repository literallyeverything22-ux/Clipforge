{
  "id": "karaoke",
  "name": "Karaoke",
  "order": 3,
  "description": "Large word-by-word captions with vibrant active-word glow and pop.",
  "category": "dynamic",
  "recommended": true,
  "bestFor": "Podcasts, high-energy interviews, motivational clips",
  "canvas": {
    "aspectRatio": "9:16",
    "width": 1080,
    "height": 1920
