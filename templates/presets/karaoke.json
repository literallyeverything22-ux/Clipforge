    "fontWeight": 900,
    "fontSize": 72,
    "case": "uppercase",
    "maxLines": 2,
    "maxWordsPerLine": 4,
    "alignment": "center",
    "position": {
      "x": 540,
      "y": 1260
    },
    "safeArea": true,
    "textColor": "#FFFFFF",
    "highlightColor": "#00E676",
    "stroke": {
      "enabled": true,
      "width": 5,
      "color": "#000000"
    },
    "shadow": {
      "enabled": true,
      "blur": 10,
      "offsetY": 4
    },
    "highlightMode": "active_word",
    "animation": "word_pop",
